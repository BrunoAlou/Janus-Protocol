  "description": "Elementos interativos da sala de arquivos",
  "elements": [
    {
      "id": "npc_archivist_1",
      "type": "npc",
      "name": "Arquivista Ana",
      "description": "Responsavel pela triagem inicial dos documentos.",
      "area": {
        "x": 214,
        "y": 172,
        "width": 68,
        "height": 88
      },
      "indicator": {
        "text": "[E]",
        "offsetY": -46
      },
      "greeting": "Bem-vindo ao arquivo. Precisa localizar algum documento?",
      "options": [
        {
          "id": "opt_archive_info_1",
          "label": "Como o arquivo e organizado?",
          "icon": "i",
          "action": {
            "type": "dialog",
            "data": {
              "dialogues": [
                { "text": "Separacao por setor, ano e nivel de sigilo." },
                { "text": "Isso reduz muito o tempo de busca." }
              ]
            }
          }
        },
        {
          "id": "opt_archive_find_1",
          "label": "Preciso localizar um documento",
          "icon": "?",
          "action": {
            "type": "dialog",
            "data": {
              "dialogues": [
                { "text": "Me diga setor e periodo para eu filtrar a estante correta." }
              ]
            }
          }
        },
        {
          "id": "opt_archive_rules_1",
          "label": "Regras de consulta",
          "icon": "!",
          "action": {
            "type": "dialog",
            "data": {
              "dialogues": [
                { "text": "Retirada apenas com registro e devolucao no mesmo turno." }
              ]
            }
          }
        },
        {
          "id": "opt_archive_bye_1",
          "label": "Obrigado",
          "icon": ">",
          "action": {
            "type": "dialog",
            "data": {
              "dialogues": [
                { "text": "Qualquer duvida, estarei por aqui." }
              ]
            }
          }
        }
      ]
    },
